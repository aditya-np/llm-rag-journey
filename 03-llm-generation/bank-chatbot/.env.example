# Optional demo token overrides. Defaults include Alex, Jamie, and 50 concurrency profiles.
DEMO_TOKENS_JSON={}
DATABASE_URL=sqlite:///./data/banking.sqlite3
SELF_SERVICE_LIMIT_INCREASE_MAX=1000
APP_ENV=development
# Local Ollama using its OpenAI-compatible Responses API.
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:0.8b
LLM_TIMEOUT_SECONDS=120
LLM_WARMUP_ENABLED=true
LLM_WARMUP_TIMEOUT_SECONDS=45

